# Default text detection with LF line endings for Docker compatibility
* text=auto eol=lf

# Explicitly enforce LF for source, configuration, and PLC files
Dockerfile text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.st text eol=lf

# Strictly treat PDFs and medical images as binary to prevent byte-offset corruption
*.pdf binary -eol
*.png binary -eol
*.jpg binary -eol
*.jpeg binary -eol
*.dcm binary -eol